# --- 必須（Render の Environment に設定済みのもの） ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
APP_USER_ID=default
GOOGLE_CALENDAR_ID=
GEMINI_API_KEY=

# --- 任意（新規） ---
# ダッシュボードにBasic認証をかける。設定すると、ブラウザがIDとパスワードを聞いてくる
DASHBOARD_PASSWORD=
DASHBOARD_USER=me
# 扶養の壁の目安（円）。既定は 1030000
FUYOU_LIMIT=1030000
# 画像解析に使う Gemini のモデル名。既定は gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
